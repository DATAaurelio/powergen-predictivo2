    {
      "cell_type": "code",
      "source": [
        "# Identificar variables numéricas y categóricas\n",
        "num_cols = df_info_equipos_copia.select_dtypes(include=['int64', 'float64']).columns.tolist()\n",
        "cat_cols = df_info_equipos_copia.select_dtypes(include=['object']).columns.tolist()\n",
        " \n",
        "print(f\"Variables numéricas: {len(num_cols)}\")\n",
        "print(f\"Variables categóricas: {len(cat_cols)}\")"
      ],
      "outputs": [
        {
